# Service Configuration
APP_NAME="Self-Monitoring MLOps System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Security & API Keys
ADMIN_API_KEY="admin-secret-key-prod-demo"
ML_ENGINEER_API_KEY="engineer-secret-key-prod-demo"
VIEWER_API_KEY="viewer-secret-key-prod-demo"
SERVICE_API_KEY="service-secret-key-prod-demo"

# Monitoring & Drift Thresholds
DRIFT_P_VALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.25
ERROR_RATE_ALERT_THRESHOLD=0.05
P95_LATENCY_ALERT_THRESHOLD_MS=500.0

# Recovery & Validation Gates
MIN_ACCURACY_THRESHOLD=0.80
MAX_LATENCY_THRESHOLD_MS=150.0
AUTO_RETRAIN_ENABLED=true
REQUIRE_DUAL_APPROVAL=true

# Storage & MLflow
DATABASE_PATH="data/monitoring_store.db"
MLFLOW_TRACKING_URI="sqlite:///data/mlflow.db"
MODEL_REGISTRY_DIR="data/models"
